    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.0",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pdfkit": "^0.19.1",
    "pino": "^8.17.0",
    "prisma": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
