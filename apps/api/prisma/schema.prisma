generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Identity Domain

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CLOSED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  LOGGED_OUT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique @db.VarChar(255)
  code      String             @unique @db.VarChar(50)
  email     String?            @db.VarChar(255)
  phone     String?            @db.VarChar(50)
  kraPin    String?            @db.VarChar(50)
  currency  String             @default("KES") @db.VarChar(3)
  timezone  String             @default("Africa/Nairobi") @db.VarChar(100)
  logoUrl   String?
  status    OrganizationStatus @default(TRIAL)
  createdAt DateTime           @default(now()) @db.Timestamp
  updatedAt DateTime           @updatedAt @db.Timestamp
  deletedAt DateTime?          @db.Timestamp

  branches  Branch[]
  users     User[]
  sessions  Session[]
  auditLogs AuditLog[]
  roles     Role[]
  categories Category[]
  brands     Brand[]
  units      Unit[]
  taxes      Tax[]
  products   Product[]
  warehouses Warehouse[]
  stocks     Stock[]
  stockMovements StockMovement[]
  suppliers  Supplier[]
  customers  Customer[]
  carts      Cart[]
  sales      Sale[]
  payments   Payment[]
  receipts   Receipt[]
  numberSequences NumberSequence[]

  @@index([code], map: "organizations_code_idx")
  @@index([status], map: "organizations_status_idx")
  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(255)
  code           String    @db.VarChar(50)
  phone          String?   @db.VarChar(50)
  email          String?   @db.VarChar(255)
  address        String?
  city           String?
  country        String?   @default("Kenya") @db.VarChar(100)
  isHeadOffice   Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  sessions     Session[]
  auditLogs    AuditLog[]
  warehouses   Warehouse[]

  @@unique([organizationId, code], map: "branches_org_code_unique")
  @@index([organizationId], map: "branches_org_id_idx")
  @@map("branches")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  firstName      String     @db.VarChar(100)
  lastName       String     @db.VarChar(100)
  email          String     @db.VarChar(255)
  phone          String?    @db.VarChar(50)
  avatarUrl      String?
  passwordHash   String     @db.VarChar(255)
  status         UserStatus @default(PENDING)
  emailVerified  Boolean    @default(false)
  lastLoginAt    DateTime?  @db.Timestamp
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  branchId     String      @db.Uuid
   roles        UserRole[]
   sessions     Session[]
   auditLogs    AuditLog[]
   sales        Sale[]

  @@unique([organizationId, email], map: "users_org_email_unique")
  @@index([organizationId], map: "users_org_id_idx")
  @@index([email], map: "users_email_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  name           String    @unique @db.VarChar(100)
  description    String?
  isSystem       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserRole[]
  permissions  RolePermission[]
  auditLogs    AuditLog[]

  @@unique([organizationId, name], map: "roles_org_name_unique")
  @@index([organizationId], map: "roles_org_id_idx")
  @@index([isSystem], map: "roles_is_system_idx")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamp

  roles RolePermission[]

  @@index([module], map: "permissions_module_idx")
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamp

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId], map: "user_roles_user_id_idx")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  userId           String        @db.Uuid
  branchId         String        @db.Uuid
  refreshTokenHash String        @unique @db.VarChar(255)
  ipAddress        String?       @db.VarChar(45)
  userAgent        String?
  expiresAt        DateTime      @db.Timestamp
  lastActivityAt   DateTime      @db.Timestamp
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId], map: "sessions_org_id_idx")
  @@index([userId], map: "sessions_user_id_idx")
  @@index([refreshTokenHash], map: "sessions_refresh_token_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  actorId        String?     @db.Uuid
  action         AuditAction
  entity         String      @db.VarChar(100)
  entityId       String      @db.VarChar(255)
  oldValues      Json?
  newValues      Json?
  ipAddress      String?     @db.VarChar(45)
  userAgent      String?
  requestId      String?     @db.VarChar(255)
  createdAt      DateTime    @default(now()) @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  branchId    String?      @db.Uuid
  role        Role?        @relation(fields: [roleId], references: [id])
  roleId      String?      @db.Uuid

  @@index([organizationId], map: "audit_logs_org_id_idx")
  @@index([actorId], map: "audit_logs_actor_id_idx")
  @@index([entity, entityId], map: "audit_logs_entity_idx")
  @@index([action], map: "audit_logs_action_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(50)
  description    String?
  color          String?   @db.VarChar(20)
  isActive       Boolean   @default(true)
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(50)
  description    String?
  logoUrl        String?
  website        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("brands")
}

model Unit {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(50)
  description    String?
  abbreviation   String?   @db.VarChar(20)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
  @@map("units")
}

model Tax {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(50)
  description    String?
  rate           Decimal   @db.Decimal(10, 4)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
  @@map("taxes")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(50)
  description    String?
  sku            String?   @db.VarChar(100)
  barcode        String?   @db.VarChar(100)
  categoryId     String?   @db.Uuid
  brandId        String?   @db.Uuid
  unitId         String    @db.Uuid
  taxId          String?   @db.Uuid
  costPrice      Decimal   @db.Decimal(10, 2)
  sellingPrice   Decimal   @db.Decimal(10, 2)
  lowStockThreshold Int?   @db.Integer
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
  brand        Brand?       @relation(fields: [brandId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
  tax          Tax?         @relation(fields: [taxId], references: [id])
  stocks       Stock[]
  stockMovements StockMovement[]
  cartItems    CartItem[]
  saleItems    SaleItem[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([isActive])
  @@map("products")
}

model Warehouse {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  branchId       String    @db.Uuid
  code           String    @db.VarChar(50)
  name           String    @db.VarChar(150)
  description    String?
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  stocks       Stock[]
  stockMovements StockMovement[]
  carts        Cart[]
  sales        Sale[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([isDefault])
  @@map("warehouses")
}

model Stock {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  warehouseId    String    @db.Uuid
  productId      String    @db.Uuid
  quantity       Decimal   @db.Decimal(12, 3) @default(0)
  reservedQuantity Decimal @db.Decimal(12, 3) @default(0)
  updatedAt      DateTime  @updatedAt @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  movements    StockMovement[]

  @@unique([organizationId, warehouseId, productId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@map("stocks")
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  EXPIRED
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  warehouseId    String            @db.Uuid
  productId      String            @db.Uuid
  stockId        String            @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  referenceType  String?           @db.VarChar(50)
  referenceId    String?           @db.Uuid
  performedBy    String?           @db.Uuid
  remarks        String?
  createdAt      DateTime          @default(now()) @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  stock        Stock        @relation(fields: [stockId], references: [id])

  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Supplier {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String    @db.VarChar(50)
  name           String    @db.VarChar(150)
  contactPerson  String?   @db.VarChar(150)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  taxPin         String?   @db.VarChar(50)
  creditLimit    Decimal?  @db.Decimal(12, 2)
  paymentTerms   String?   @db.VarChar(100)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
  @@map("suppliers")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String    @db.VarChar(50)
  name           String    @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  email          String?   @db.VarChar(255)
  taxPin         String?   @db.VarChar(50)
  address        String?
  loyaltyPoints  Decimal   @db.Decimal(12, 2) @default(0)
  creditLimit    Decimal?  @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]
  carts        Cart[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("customers")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  customerId     String?    @db.Uuid
  warehouseId    String     @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  items        CartItem[]

  @@index([organizationId])
  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  price          Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @db.Timestamp

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

enum SaleStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  number         String     @db.VarChar(50)
  customerId     String?    @db.Uuid
  warehouseId    String     @db.Uuid
  cashierId      String     @db.Uuid
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @db.Decimal(12, 2) @default(0)
  tax            Decimal    @db.Decimal(12, 2) @default(0)
  total          Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(PENDING)
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp

   organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
   customer     Customer?    @relation(fields: [customerId], references: [id])
   warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
   cashier      User         @relation(fields: [cashierId], references: [id])
   items        SaleItem[]
  payments     Payment[]
  receipts     Receipt[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  price          Decimal  @db.Decimal(10, 2)
  discount       Decimal  @db.Decimal(10, 2) @default(0)
  tax            Decimal  @db.Decimal(10, 2) @default(0)
  subtotal       Decimal  @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK
  CREDIT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  saleId         String        @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?       @db.VarChar(100)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?     @db.Timestamp
  createdAt      DateTime      @default(now()) @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@index([status])
  @@map("payments")
}

model Receipt {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  saleId         String   @db.Uuid
  number         String   @db.VarChar(50)
  issuedAt       DateTime @default(now()) @db.Timestamp
  createdAt      DateTime @default(now()) @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([saleId])
  @@map("receipts")
}

model NumberSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String   @db.VarChar(50)
  prefix         String   @db.VarChar(20)
  lastNumber     Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamp
  updatedAt      DateTime @updatedAt @db.Timestamp

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType])
  @@index([organizationId])
  @@map("number_sequences")
}
